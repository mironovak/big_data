<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/market.owl"
         xmlns="http://example.org/market.owl#">

<owl:Ontology rdf:about="http://example.org/market.owl"/>

<owl:ObjectProperty rdf:about="#делает_заказ">
  <rdfs:domain rdf:resource="#Покупатель"/>
  <rdfs:range rdf:resource="#Заказ"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#содержит_строку">
  <rdfs:domain rdf:resource="#Заказ"/>
  <rdfs:range rdf:resource="#СтрокаЗаказа"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ссылается_на_товар">
  <rdfs:domain rdf:resource="#СтрокаЗаказа"/>
  <rdfs:range rdf:resource="#Товар"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#оставляет_отзыв">
  <rdfs:domain rdf:resource="#Покупатель"/>
  <rdfs:range rdf:resource="#Отзыв"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#отзыв_на_товар">
  <rdfs:domain rdf:resource="#Отзыв"/>
  <rdfs:range rdf:resource="#Товар"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#имеет_email">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Покупатель"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#имеет_цена">
